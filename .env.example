# MySQL database (Hostinger: hPanel → Databases → MySQL Databases)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE"

# Random strings (generate with: openssl rand -hex 32)
AUTH_SECRET="long-random-string"
CRON_SECRET="another-random-string"

# Azure app registration (Entra ID)
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_MAILBOX="owner@clientdomain.com"

# First admin login, created automatically on start if it doesn't exist
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# 1 = only sync new mail, don't import older mail. Remove or set 0 to import the whole mailbox.
PAUSE_IMPORT="0"
